{
  "name": "idle-rpg-absorber",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based idle RPG. Farm with a roster of characters, absorb enemy strengths, upgrade gear that cannot be fully maxed.",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node tools/build-tokens.mjs",
    "tokens:check": "node tools/build-tokens.mjs --check",
    "dev-strip:check": "node tools/check-dev-strip.mjs",
    "validate:data": "node tools/validate-data.mjs",
    "balance:combat": "vite-node tools/balance/combat-sim.ts --",
    "balance:drops": "vite-node tools/balance/drop-calc.ts --",
    "balance:progression": "vite-node tools/balance/progression.ts --",
    "check": "npm run typecheck && npm test && npm run validate:data && npm run tokens:check && npm run dev-strip:check"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "lucide-static": "^1.67.0",
    "preact": "^11.1.1"
  }
}
